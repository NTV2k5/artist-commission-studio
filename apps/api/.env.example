# ==============================================================================
# @STUDIO/API ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=4000
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/artist_studio?schema=public

# Redis (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379

# Client CORS & Origins
CORS_ORIGIN=http://localhost:3000

# Artist Admin Account
ARTIST_ADMIN_EMAIL=artist@studio.vn

# SePay VietQR Integration
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_BANK_NAME=MBBank

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare R2 / AWS S3 Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET_NAME=artist-commission-studio
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
