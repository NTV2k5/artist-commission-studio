# ==============================================================================
# @STUDIO/WEB ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API & WebSocket Endpoints
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# NextAuth (Auth.js v5)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_at_least_32_chars

# OAuth Providers (Optional for local dev)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudflare R2 Public Media Storage
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev
