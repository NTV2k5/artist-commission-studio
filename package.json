{
  "name": "artist-commission-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Artist Commission Studio - Monorepo for Custom Artwork & Mural Commissioning",
  "scripts": {
    "dev": "pnpm --parallel --filter @studio/web --filter @studio/api dev",
    "build": "pnpm --filter @studio/shared build && pnpm --filter @studio/api build && pnpm --filter @studio/web build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:generate": "pnpm --filter @studio/api prisma generate",
    "db:migrate": "pnpm --filter @studio/api prisma migrate dev",
    "db:seed": "pnpm --filter @studio/api prisma db seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
